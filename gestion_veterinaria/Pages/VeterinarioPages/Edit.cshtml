@page
@model gestion_veterinaria.Pages.VeterinarioPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Veterinario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Veterinario.Id" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Veterinario.Nombre" class="control-label"></label>
                <input asp-for="Veterinario.Nombre" class="form-control" aria-required="true"/>
                <span asp-validation-for="Veterinario.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Veterinario.Apellidos" class="control-label"></label>
                <input asp-for="Veterinario.Apellidos" class="form-control" aria-required="true"/>
                <span asp-validation-for="Veterinario.Apellidos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Veterinario.Especialidad" class="control-label"></label>
                <input asp-for="Veterinario.Especialidad" class="form-control" />
                <span asp-validation-for="Veterinario.Especialidad" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Veterinario.Telefono" class="control-label"></label>
                <input asp-for="Veterinario.Telefono" class="form-control" />
                <span asp-validation-for="Veterinario.Telefono" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Veterinario.Estado" class="control-label"></label>
                <input asp-for="Veterinario.Estado" class="form-control" aria-required="true"/>
                <span asp-validation-for="Veterinario.Estado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
