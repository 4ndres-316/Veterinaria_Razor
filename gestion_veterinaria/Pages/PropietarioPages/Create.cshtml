@page
@model gestion_veterinaria.Pages.PropietarioPages.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Propietario</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Propietario.Nombre" class="control-label"></label>
                <input asp-for="Propietario.Nombre" class="form-control" aria-required="true"/>
                <span asp-validation-for="Propietario.Nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Propietario.Apellidos" class="control-label"></label>
                <input asp-for="Propietario.Apellidos" class="form-control" aria-required="true"/>
                <span asp-validation-for="Propietario.Apellidos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Propietario.Telefono" class="control-label"></label>
                <input asp-for="Propietario.Telefono" class="form-control" />
                <span asp-validation-for="Propietario.Telefono" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Propietario.Email" class="control-label"></label>
                <input asp-for="Propietario.Email" class="form-control" />
                <span asp-validation-for="Propietario.Email" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Propietario.Estado" class="control-label"></label>
                <select asp-for="Propietario.Estado" class="form-control" aria-required="true"
                        asp-items="Html.GetEnumSelectList<gestion_veterinaria.Models.EstadoPropietario>()">
                    <option value="">-- Seleccione un Estado --</option>
                </select>
                <span asp-validation-for="Propietario.Estado" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
