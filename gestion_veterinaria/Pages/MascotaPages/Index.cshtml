@page
@model gestion_veterinaria.Pages.MascotaPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Mascota[0].Propietario)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mascota[0].Nombre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mascota[0].Especie)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mascota[0].Raza)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mascota[0].FechaNacimiento)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Mascota[0].Estado)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Mascota) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Propietario.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Nombre)
            </td>
            <td>
                @Html.DisplayFor(model => item.Especie)
            </td>
            <td>
                @Html.DisplayFor(model => item.Raza)
            </td>
            <td>
                @Html.DisplayFor(model => item.FechaNacimiento)
            </td>
            <td>
                @Html.DisplayFor(model => item.Estado)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
